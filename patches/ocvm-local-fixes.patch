 ////////////////// PIPED COMMAND ////////////////////////
@@ -148,7 +135,24 @@ int PipedCommand::id() const
 
 void PipedCommand::close()
 {
-  ::close(_child_id);
+  if (_child_id > 0)
+  {
+    // 先 SIGKILL 再阻塞 waitpid 确保收割: 旧版只 WNOHANG 一次就
+    // _child_id=-1 放弃跟踪——子进程（wget）仍在跑时被弃置:
+    // ocvm 退出留 wget 孤儿（实证: /exit 后残留 wget 75% CPU 自旋），
+    // 且槽位随弃置进程悬挂。kill 对已退出的 pid 无害（ESRCH 忽略）。
+    ::kill(_child_id, SIGKILL);
+    int wstatus = 0;
+    while (::waitpid(_child_id, &wstatus, 0) < 0)
+    {
+      if (errno == EINTR)
+      {
+        continue;
+      }
+      break;  // ECHILD: 已被收割
+    }
+    _child_id = -1;
+  }
 }
 
